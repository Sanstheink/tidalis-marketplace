# Copy this file to .env.local, then configure your own Supabase project.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# App transactional emails (not used for Auth OTP: Supabase SMTP handles those).
# Keep server-side only; do not prefix with NEXT_PUBLIC_!
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Configure Resend SMTP credentials separately under Supabase Auth -> SMTP Settings.
# Do NOT add SMTP credentials as NEXT_PUBLIC_ variables.

# Seller intake is controlled by the MFA admin at /admin/seller-applications.
# Its authoritative database setting starts closed; no env flag is required.
# Phase 3: configure a Supabase STAGING project and its permitted Auth Redirect URLs
# Google OAuth is optional, but requires provider setup in Supabase + Google Cloud.
# For test on Vercel add matching Preview env vars, then Redeploy.

# Server only: required for verified proof hashing. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
